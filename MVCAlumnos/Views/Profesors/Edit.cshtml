@model MVCAlumnos.Models.Profesor

@{
    ViewData["Title"] = "Editar Profesor";
}

<h2 class="mb-4">Editar Profesor</h2>
<hr class="bg-dark mb-4" style="height: 2px; opacity: 1;" />

<div class="row mt-4">
    <div class="col-md-8">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FotoUrl" />

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Nombre" class="form-label fw-bold mb-2"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                            <input asp-for="Nombre" class="form-control" />
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger mt-1"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Correo" class="form-label fw-bold mb-2"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            <input asp-for="Correo" class="form-control" />
                        </div>
                        <span asp-validation-for="Correo" class="text-danger mt-1"></span>
                    </div>
                </div>
            </div>

            <div class="row g-4 mt-2">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Telefono" class="form-label fw-bold mb-2"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-phone"></i></span>
                            <input asp-for="Telefono" class="form-control" />
                        </div>
                        <span asp-validation-for="Telefono" class="text-danger mt-1"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Especialidad" class="form-label fw-bold mb-2"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-graduation-cap"></i></span>
                            <input asp-for="Especialidad" class="form-control" />
                        </div>
                        <span asp-validation-for="Especialidad" class="text-danger mt-1"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="CarreraId" class="form-label fw-bold mb-2">Carrera</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-building"></i></span>
                            <select asp-for="CarreraId" class="form-select" asp-items="ViewBag.CarreraId">
                                <option value="">-- Seleccione una carrera --</option>
                            </select>
                        </div>
                        <span asp-validation-for="CarreraId" class="text-danger mt-1"></span>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.FotoUrl))
            {
                <div class="form-group mt-4">
                    <label class="form-label fw-bold mb-2">Foto actual</label>
                    <div>
                        <img src="@Model.FotoUrl" width="100" height="100" class="rounded-circle border" />
                    </div>
                </div>
            }

            <div class="form-group mt-4">
                <label class="form-label fw-bold mb-2">Foto</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-image"></i></span>
                    <input type="file" name="foto" class="form-control" accept="image/*" />
                </div>
            </div>

            <div class="form-group mt-5">
                <button type="submit" class="btn btn-dark px-4 py-2">
                    Guardar
                </button>
                <a asp-action="Index" class="btn btn-secondary px-4 py-2">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}