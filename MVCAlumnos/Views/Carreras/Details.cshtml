@model MVCAlumnos.Models.Carrera

@{
    var esDelete = ViewContext.RouteData.Values["action"].ToString() == "Delete";
    ViewData["Title"] = esDelete ? "Eliminar Carrera" : "Detalles de la Carrera";
}

<h2 class="mb-4">@ViewData["Title"]</h2>
<hr class="bg-dark mb-4" style="height: 2px; opacity: 1;" />

<div class="row mt-4">
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Model.Codigo</dd>

            <dt class="col-sm-3">Duración</dt>
            <dd class="col-sm-9">@Model.DuracionSemestres semestres</dd>

            <dt class="col-sm-3">Descripción</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)</dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    @if (!esDelete)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            Editar
        </a>
    }
    else
    {
        <form asp-action="Delete" class="d-inline">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                Eliminar
            </button>
        </form>
    }
    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>
</div>