@model MVCAlumnos.Models.AlumnoMateria

@{
    ViewData["Title"] = "Detalles de la Asignación";
}

<h2 class="mb-4">Detalles de la Asignación</h2>
<hr class="bg-dark mb-4" style="height: 2px; opacity: 1;" />

<div class="row mt-4">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Alumno</dt>
            <dd class="col-sm-8">@Model.Alumno?.Nombre</dd>

            <dt class="col-sm-4">Materia</dt>
            <dd class="col-sm-8">@Model.Materia?.Nombre</dd>

            <dt class="col-sm-4">Carrera</dt>
            <dd class="col-sm-8">@Model.Materia?.Carrera?.Nombre</dd>

            <dt class="col-sm-4">Créditos</dt>
            <dd class="col-sm-8">@Model.Materia?.Creditos</dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>
</div>