@model IEnumerable<MVCAlumnos.Models.Materia>

@{
    ViewData["Title"] = "Mis Materias";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-book"></i> Mis Materias</h1>
</div>
<hr class="bg-dark mb-4" style="height: 2px; opacity: 1;" />

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Materia</th>
                <th>Carrera</th>
                <th>Créditos</th>
                <th>Profesor</th>
        </thead>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center py-5">
                        <i class="fas fa-info-circle fa-2x text-muted mb-2 d-block"></i>
                        <h5 class="text-muted">No tienes materias asignadas</h5>
                        <p class="text-muted">Contacta a tu profesor o administrador</p>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@(item.Carrera?.Nombre ?? "Sin asignar")</td>
                        <td>@item.Creditos</td>
                        <td>
                            @{
                                var profesor = ViewBag.ProfesoresPorMateria != null && ViewBag.ProfesoresPorMateria.ContainsKey(item.Id)
                                ? ViewBag.ProfesoresPorMateria[item.Id]
                                : "No asignado";
                            }
                            @profesor
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">
        Volver a Mi Perfil
    </a>
</div>