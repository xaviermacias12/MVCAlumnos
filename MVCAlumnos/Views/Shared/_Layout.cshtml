<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVCAlumnos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        .container {
            flex: 1 0 auto;
        }

        footer {
            flex-shrink: 0;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-black border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MVCAlumnos</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-users"></i> Administración
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Alumnos" asp-action="Index">Alumnos</a></li>
                                        <li><a class="dropdown-item" asp-controller="Profesors" asp-action="Index">Profesores</a></li>
                                        <li><a class="dropdown-item" asp-controller="Materias" asp-action="Index">Materias</a></li>
                                        <li><a class="dropdown-item" asp-controller="Carreras" asp-action="Index">Carreras</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="ProfesorMaterias" asp-action="Index">Asignar Materias a Profesores</a></li>
                                        <li><a class="dropdown-item" asp-controller="AlumnoMaterias" asp-action="Index">Asignar Materias a Alumnos</a></li>
                                    </ul>
                                </li>
                            }
                            @if (User.IsInRole("Profesor"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-chalkboard"></i> Profesor
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="ProfesorPanel" asp-action="MisMaterias">Mis Materias</a></li>
                                        <li><a class="dropdown-item" asp-controller="AlumnoMaterias" asp-action="Index">Asignar Alumnos</a></li>
                                    </ul>
                                </li>
                            }
                            @if (User.IsInRole("Alumno"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-user-graduate"></i> Alumno
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="PerfilAlumno" asp-action="Index">Mi Perfil</a></li>
                                        <li><a class="dropdown-item" asp-controller="PerfilAlumno" asp-action="MisMaterias">Mis Materias</a></li>
                                    </ul>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>
                        }
                    </ul>

                    <!-- Partial de login -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3" style="background-color: #f8f9fa; margin-top: auto;">
        <div class="container text-center">
            &copy; 2026 - MVCAlumnos - Sistema de Gestión de Alumnos
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>