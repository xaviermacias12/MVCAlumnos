@model IEnumerable<MVCAlumnos.Models.ProfesorMateria>

@{
    ViewData["Title"] = "Asignaciones de Materias a Profesores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-chalkboard-user"></i> Asignaciones de Materias a Profesores</h1>
    <a asp-action="Create" class="btn btn-dark">
        <i class="fas fa-plus-circle"></i> Nueva Asignación
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Profesor</th>
                <th>Materia</th>
                <th>Carrera</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center py-5">
                        <i class="fas fa-search fa-2x text-muted mb-2 d-block"></i>
                        <h5 class="text-muted">No hay asignaciones registradas</h5>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Profesor?.Nombre</td>
                        <td>@item.Materia?.Nombre</td>
                        <td>@item.Materia?.Carrera?.Nombre</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>