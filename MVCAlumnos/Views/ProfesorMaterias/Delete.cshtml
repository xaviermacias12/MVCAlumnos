@model MVCAlumnos.Models.ProfesorMateria

@{
    ViewData["Title"] = "Eliminar Asignación";
}

<h2 class="mb-4">Eliminar Asignación</h2>
<hr class="bg-dark mb-4" style="height: 2px; opacity: 1;" />

<div class="alert alert-warning">
    ¿Está seguro de eliminar esta asignación?
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Profesor</dt>
            <dd class="col-sm-8">@Model.Profesor?.Nombre</dd>

            <dt class="col-sm-4">Materia</dt>
            <dd class="col-sm-8">@Model.Materia?.Nombre</dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    <form asp-action="Delete" class="d-inline">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger px-4 py-2">
            Eliminar
        </button>
    </form>
    <a asp-action="Index" class="btn btn-secondary px-4 py-2">
        Cancelar
    </a>
</div>