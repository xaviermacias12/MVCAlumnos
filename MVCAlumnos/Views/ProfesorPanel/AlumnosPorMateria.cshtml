@model IEnumerable<MVCAlumnos.Models.Alumnos>

@{
    ViewData["Title"] = "Alumnos por Materia";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-users"></i> Alumnos Asignados</h1>
    <a asp-action="MisMaterias" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Volver a Mis Materias
    </a>
</div>
<hr class="bg-dark mb-4" style="height: 2px; opacity: 1;" />

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Semestre</th>
                <th>Carrera</th>
        </thead>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-5">
                        <i class="fas fa-info-circle fa-2x text-muted mb-2 d-block"></i>
                        <h5 class="text-muted">No hay alumnos asignados a esta materia</h5>
                        <p class="text-muted">Haz clic en "Asignar" para agregar alumnos</p>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Correo</td>
                        <td>@item.Telefono</td>
                        <td>@item.Semestre</td>
                        <td>@(item.Carrera?.Nombre ?? "Sin asignar")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>